# RAT Detection Lab backend — example environment.
# Copy to .env and adjust. NEVER commit real secrets.
LAB_ENVIRONMENT=lab
LAB_HOST=127.0.0.1
LAB_PORT=8000
LAB_PROTOCOL_VERSION=1.0
# Fallback dev signing secret; per-device secrets are registered at runtime.
LAB_HMAC_SECRET=dev-only-lab-secret-change-me
LAB_PAYLOAD_TTL_SECONDS=30
LAB_MAX_PAYLOAD_BYTES=8192
LAB_NONCE_CACHE_TTL_SECONDS=120
LAB_RATE_LIMIT_PER_MINUTE=60
# Local default is SQLite; docker-compose points this at PostgreSQL.
LAB_DATABASE_URL=sqlite:///./lab.db
LAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
